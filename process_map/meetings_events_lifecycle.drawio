rent="1"><mxGeometry x="1060" y="570" width="190" height="70" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Virtual Card Issuance&lt;/b&gt;&lt;br/&gt;Generate Single-Use Card&lt;br/&gt;Tied to Cvent Meeting ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#EC4899;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="570" y="720" width="190" height="70" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;SAP Concur Expense&lt;/b&gt;&lt;br/&gt;Itemized BEO Folio Matching&lt;br/&gt;&amp; Out-of-Pocket Reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#EC4899;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1290" y="720" width="190" height="70" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;SAP S/4HANA Posting&lt;/b&gt;&lt;br/&gt;Settle to WBS / Cost Center,&lt;br/&gt;Clear Virtual Card AP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#F43F5E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1510" y="870" width="180" height="70" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;Snowflake Agg Spend&lt;/b&gt;&lt;br/&gt;Publish US CMS &amp; EFPIA&lt;br/&gt;Tax Compliance Feeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#F43F5E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1710" y="870" width="150" height="70" as="geometry" /></mxCell><mxCell id="dlp1" value="&lt;b&gt;DLP-1: Rogue Booking&lt;/b&gt;&lt;br/&gt;Hotel direct booking;&lt;br/&gt;bypasses Cvent &amp; SMM controls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7F1D1D;strokeColor=#EF4444;strokeWidth=2;fontColor=#FEF2F2;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="85" width="200" height="55" as="geometry" /></mxCell><mxCell id="dlp2" value="&lt;b&gt;DLP-2: HCP NPI / FMV Disconnect&lt;/b&gt;&lt;br/&gt;Missing 10-digit NPI or FMV tier;&lt;br/&gt;Sunshine Act non-disclosure risk." style="rounded=1;whiteSpace=wrap;html=