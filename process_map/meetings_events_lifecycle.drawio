<mxfile host="app.diagrams.net" modified="2026-10-18T10:00:00.000Z" agent="MeridianGlobal/2.0" version="24.0.0" type="device"><diagram id="meridian_meetings_lifecycle" name="Global Meetings Lifecycle &amp; Data Leakage Map"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_1" value="&lt;b&gt;MERIDIAN BIOPHARMA GLOBAL OPERATIONS | STRATEGIC MEETINGS &amp; EVENTS DATA LIFECYCLE&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;End-to-End Governance Architecture &amp; Critical Data Leakage Point (DLP) Matrix | [SYNTHETIC DEMO PURPOSES ONLY]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="60" as="geometry" /></mxCell><mxCell id="lane_req" value="&lt;b&gt;1. REQUESTER &amp; BUSINESS UNIT (Commercial / Medical Affairs)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#38BDF8;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1840" height="140" as="geometry" /></mxCell><mxCell id="lane_comp" value="&lt;b&gt;2. MEDICAL COMPLIANCE &amp; LEGAL (FMV / Sunshine / Transparency)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#A78BFA;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1840" height="140" as="geometry" /></mxCell><mxCell id="lane_smm" value="&lt;b&gt;3. SMM ENTERPRISE ENGINE (Cvent Enterprise / Intake)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#34D399;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1840" height="140" as="geometry" /></mxCell><mxCell id="lane_tmc" value="&lt;b&gt;4. TRAVEL &amp; LOGISTICS (Corporate Travel &amp; Ground Fleet)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FBBF24;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1840" height="140" as="geometry" /></mxCell><mxCell id="lane_card" value="&lt;b&gt;5. PAYMENT &amp; EXPENSE RECONCILIATION (Virtual Card / SAP Concur)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#F472B6;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1840" height="140" as="geometry" /></mxCell><mxCell id="lane_erp" value="&lt;b&gt;6. ERP &amp; AGGREGATE SPEND LAKE (SAP S/4HANA / CMS Sunshine / EFPIA)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FB7185;fontSize=11;startSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1840" height="150" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Meeting Initiation&lt;/b&gt;&lt;br/&gt;Define Purpose, Budget,&lt;br/&gt;Target Dates &amp; Cost Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="180" height="70" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Event Execution&lt;/b&gt;&lt;br/&gt;Host Symposium &amp; Manage&lt;br/&gt;Physical/Virtual Attendees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="120" width="180" height="70" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Post-Event Closeout&lt;/b&gt;&lt;br/&gt;Collect Actual Sign-In&lt;br/&gt;Roster &amp; Reconcile No-Shows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;fontColor=#FFFFFF;" vertex="1" parent="1">